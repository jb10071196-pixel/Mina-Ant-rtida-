-- SISTEMAS PROTEGIDOS (ANTI-BANEO)
-- =========================================================================

-- 1. Auto-Minar con Intervalos de Fatiga Simulada
local btnMinar = CrearBotón("⛏️ Minar Automático: NO", Color3.fromRGB(180, 60, 60), function()
    _G.AutoMineria = not _G.AutoMineria
end)

task.spawn(function()
    while true do
        -- Retraso variable en lugar de un bucle estático rápido de 0.1s
        task.wait(ObtenerRetrasoHumano(0.25, 0.45)) 
        
        if _G.AutoMineria then
            pcall(function()
                local char = LocalPlayer.Character
                local mochila = LocalPlayer.Backpack
                
                -- Equipar simulando tiempo de reacción al aparecer
                local pico = mochila:FindFirstChildOfClass("Tool")
                if pico then
                    task.wait(ObtenerRetrasoHumano(0.1, 0.3))
                    pico.Parent = char
                end
                
                local picoEquipado = char:FindFirstChildOfClass("Tool")
                if picoEquipado then
                    picoEquipado:Activate()
                    -- Agrega pausas aleatorias muy breves imitando el cansancio humano
                    if math.random(1, 25) == 12 then
                        task.wait(ObtenerRetrasoHumano(0.6, 1.2))
                    end
                end
            end)
        end
    end
end)

-- 2. Auto-Venta Humanizada por Simulación de Caminata Corta (No Teleport Directo)
local btnVender = CrearBotón("💰 Auto-Vender: NO", Color3.fromRGB(180, 60, 60), function()
    _G.AutoVenta = not _G.AutoVenta
end)

task.spawn(function()
    while true do
        -- Escanea la mochila de forma espaciada e impredecible (cada 3 a 6 segundos)
        task.wait(ObtenerRetrasoHumano(3.0, 6.0))
        
        if _G.AutoVenta then
            pcall(function()
                local zonaVenta = Workspace:FindFirstChild("SellZone") or Workspace:FindFirstChild("Sell") or Workspace:FindFirstChild("Venta")
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                
                if zonaVenta and hrp then
                    -- BYPASS DE TELEPORT SEGURO:
                    -- Los anti-cheats miden los saltos drásticos de coordenadas en 0 segundos.
                    -- Usamos TweenService para deslizar suavemente al personaje a velocidad normal/alta
                    local posOriginal = hrp.CFrame
                    local distancia = (hrp.Position - zonaVenta.Position).Magnitude
                    
                    if distancia > 15 then
                        -- Simular un viaje rápido pero con trayectoria fluida evaluada por el motor
                        local tiempoViaje = distancia / 90 -- Velocidad simulada segura
                        local tweenInfo = TweenInfo.new(tiempoViaje, Enum.EasingStyle.Linear)
                        local moverIda = TweenService:Create(hrp, tweenInfo, {CFrame = zonaVenta.CFrame})
                        
                        moverIda:Play()
                        moverIda.Completed:Wait()
                        
                        task.wait(ObtenerRetrasoHumano(0.8, 1.4)) -- Tiempo esperando que el servidor procese la venta
                        
                        -- Regresar paulatinamente al punto de origen
                        local moverVuelta = TweenService:Create(hrp, tweenInfo, {CFrame = posOriginal})
                        moverVuelta:Play()
                        moverVuelta.Completed:Wait()
                    end
                end
            end)
        end
    end
end)

-- 3. Modificador de Velocidad Regulado (Bypass de Control de Red)
local velocidadActiva = false
local btnVelocidad = CrearBotón("⚡ Velocidad Regulada: NO", Color3.fromRGB(180, 60, 60), function()
    pcall(function()
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            velocidadActiva = not velocidadActiva
            -- 24 es una velocidad ligeramente superior a la normal (16), ideal para pasar desapercibido
            hum.WalkSpeed = velocidadActiva and 24 or 16 
        end
    end)
end)

-- 4. Anti-AFK por Input de Simulación Periférica Real
LocalPlayer.Idled:Connect(function()
    if _G.AntiAFK then
        pcall(function()
            -- En vez de enviar comandos al núcleo de la conexión, simula pequeños movimientos de cámara de un mouse humano
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new(math.random(10, 100), math.random(10, 100)))
        end)
    end
end)

