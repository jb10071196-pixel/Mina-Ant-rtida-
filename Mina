-- ESTADOS GLOBALES
_G.AutoMineria = false
_G.AutoVenta = false
_G.AntiAFK = true

-- GENERADOR DE TIEMPOS HUMANOS (Evita patrones fijos que detecta el Anti-Cheat)
local function ObtenerRetrasoHumano(min, max)
    return math.random(min * 1000, max * 1000) / 1000
end

local function CrearBotón(texto, colorFondo, accion)
    local Boton = Instance.new("TextButton")
    Boton.Parent = MainFrame
    Boton.Size = UDim2.new(0.9, 0, 0, 35)
    Boton.BackgroundColor3 = colorFondo
    Boton.TextColor3 = Color3.fromRGB(255, 255, 255)
    Boton.TextSize = 12
    Boton.Font = Enum.Font.SourceSansGraphic
    Boton.Text = texto
    Boton.AnchorPoint = Vector2.new(0.5, 0)
    Boton.MouseButton1Click:Connect(accion)
    return Boton
end

